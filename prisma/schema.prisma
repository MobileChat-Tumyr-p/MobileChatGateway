generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user")
}
model UserCode {
    userEmail String @unique @map("user_email")
    succsesCode Int  @map("succses_code")
    @@map("user_code")
} 
